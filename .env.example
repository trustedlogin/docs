# Copy to `.env.local` (gitignored) and fill in.
# Algolia DocSearch — required for the navbar search box.
# Free DocSearch tier: apply at https://docsearch.algolia.com/apply/ and
# Algolia will configure the crawler and email you the three values below.
# Paid tier: create an app at https://dashboard.algolia.com/, push content
# via the docusaurus-lunr-search or @docusaurus/plugin-content-docs flow.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX_NAME=
